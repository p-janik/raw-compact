{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RAW Compact",
  "version": "0.2.0",
  "identifier": "com.pjanik.rawcompact",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RAW Compact",
        "width": 1040,
        "height": 920,
        "minWidth": 820,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#11151b",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Smaller Nikon footage, still RAW.",
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../licenses/blue-compressor-NOTICE.txt": "licenses/blue-compressor-NOTICE.txt",
      "../licenses/rawmakase-MIT.txt": "licenses/rawmakase-MIT.txt"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "license": "Apache-2.0",
    "copyright": "Copyright 2026 RAW Compact contributors"
  }
}
